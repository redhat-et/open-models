{
  "title": "OCTO Open Models - Usage & Activity",
  "uid": "open-models",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests running",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "vllm:num_requests_running", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests waiting (queue)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "vllm:num_requests_waiting", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token throughput (tok/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(vllm:prompt_tokens_total[5m])", "legendFormat": "in {{model}}" },
        { "expr": "rate(vllm:generation_tokens_total[5m])", "legendFormat": "out {{model}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Time to first token (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "E2E request latency (p50/p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "KV cache usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "vllm:gpu_cache_usage_perc", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU utilization (DCGM)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "{{Hostname}} gpu{{gpu}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host memory used %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Endpoint up",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 32 },
      "targets": [
        { "expr": "up{job=\"vllm\"}", "legendFormat": "{{model}}" }
      ]
    }
  ]
}
