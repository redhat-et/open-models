{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "octo-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OCTO Open Models gateway (metered; key from the web app)",
      "options": {
        "baseURL": "https://litellm-octo-models.apps.emerg.pcbk.p1.openshiftapps.com/v1",
        "apiKey": "{env:OCTO_KEY}"
      },
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen 3.8 Flash Next NVFP4 (Core) [gateway]",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        },
        "qwen38-27b-fast": {
          "name": "Qwen 3.8 27B NVFP4 (Bulk) [gateway]",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        },
        "glm-45-air": {
          "name": "GLM-4.5-Air 106B-A12B (Frontier) [gateway]",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        }
      }
    },
    "octo-spark2-smart": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OCTO Open Models (DGX Spark (GB10, 128GB unified) - direct/unmetered, VPN)",
      "options": {
        "baseURL": "http://octo-et-spark-2.khw.eng.rdu2.dc.redhat.com:8000/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "Qwen/Qwen3.8-27B-FP8": {
          "name": "Qwen 3.8 27B FP8 (Lab)",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        }
      }
    },
    "octo-spark4-lab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OCTO Open Models (DGX Spark (GB10, 128GB unified) - direct/unmetered, VPN)",
      "options": {
        "baseURL": "http://octo-et-spark-4.khw.eng.rdu2.dc.redhat.com:8888/v1",
        "apiKey": "none"
      },
      "models": {
        "qwen3.8-27b-sglang": {
          "name": "Qwen 3.8 27B NVFP4 + MTP (Lab)",
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        }
      }
    },
    "octo-spark3-qwen38-flash-next": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OCTO Open Models (DGX Spark (GB10, 128GB unified) - direct/unmetered, VPN)",
      "options": {
        "baseURL": "http://octo-et-spark-3.khw.eng.rdu2.dc.redhat.com:8000/v1",
        "apiKey": "none"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8-Flash-Next NVFP4 (Lab)",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        }
      }
    }
  },
  "model": "octo-gateway/qwen38-flash-next",
  "small_model": "octo-gateway/qwen38-27b-fast"
}
